---
import ProjectCard from "@/components/projectcard/ProjectCard.astro";
---

<style>
    @media (min-width: 48rem) {
        .title {
            font-size: 2.5rem;
        }
    }
    @media (min-width: 72rem) {
        .title {
            font-size: 3rem;
        }
    }
    .projects-container {
        color: #9a9a9a;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.8rem;
        padding: 2rem;
    }
    .title {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #ddd;
        text-decoration: underline #682f8e 0.3rem;
        text-underline-offset: 0.4rem;
        font-weight: 1000;
        margin-top: 4rem;
        margin-bottom: 0.5rem;
    }
</style>

<h1 class="title">projects</h1>
<div class="projects-container">
    <ProjectCard
        name="uniview-ipc-analysis"
        description="Independent security analysis of a commercial IP camera. Obtained root access via UART and U-Boot manipulation, documenting attack surface across firmware, network services, and hardware interfaces."
        tags={["hardware", "linux", "firmware", "reverse engineering"]}
        href="https://github.com/yonathangashu/uniview-ipc-analysis"
    />
    <ProjectCard
        name="lewoc"
        description="A LoRa-enabled off-grid wireless communication device built in no-std Rust on an RP Pico 2W."
        tags={["embedded", "rust", "hardware"]}
        href="https://github.com/tsar-boomba/lewoc"
    />
    <ProjectCard
        name="raycaster"
        description="2.5D raycasting engine implemented from scratch in C++ with SDL2, using ray-wall intersection and distance-based projection for real-time rendering."
        tags={["c++", "sdl2", "graphics"]}
        href="https://github.com/yonathangashu/raycaster"
    />
</div>
